# Copy to .env (never commit .env).

# Only needed on Windows machines whose antivirus scans HTTPS (e.g. Avast Web Shield).
# Build it with: python scripts/build_ca_bundle.py
CA_BUNDLE=.certs/ca-bundle.pem

# Optional: live questions in the dashboard's "Ask the portfolio" tab, through a free OpenRouter model.
# Create a key at https://openrouter.ai/settings/keys. One line, no quotes, no "export":
OPENROUTER_API_KEY=
# Optional: passcode required before a live question is sent.
CHAT_PASSCODE=
